<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kayak.web.system.mapper.SysUserMapper">
    <select id="getUserByRoleIds" resultType="com.kayak.web.system.domain.SysUser">
        select distinct su.userid ,su.username,su.orgno
        from sys_user su
        inner join sys_user_role ur on su.userid =ur.userid
        where ur.roleid in
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>
</mapper>
